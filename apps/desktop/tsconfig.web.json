{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": false,
    "paths": {
      "@/*": [
        "./src/renderer/src/*"
      ],
      "@partyco/agents": [
        "../../packages/agents/src/index.ts"
      ]
    }
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/preload/index.ts"
  ]
}
