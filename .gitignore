node_modules/
dist/
out/
build/
*.tsbuildinfo
.vite/
.turbo/

# generated from packages/tokens/src — never edit by hand, never review
packages/tokens/dist/
packages/tokens/src/tokens.generated.css

# Third-party webfont binaries + their licences and the range manifest, fetched once by
# `npm run fonts -w @partyco/tokens`. ~300 KB of .woff2 that git cannot diff and review cannot read;
# the fetch script pins the versions, so the repository does not need to hold the bytes.
# The README stays — it is what tells a fresh clone how to get them.
packages/tokens/assets/fonts/*
!packages/tokens/assets/fonts/README.md

# Electron build output
apps/desktop/release/

# hub database — created by `npm start -w @partyco/hub` next to wherever it is run from.
# WAL journalling means two sidecar files exist alongside it whenever the daemon is live.
hub.db
hub.db-wal
hub.db-shm

# ---------------------------------------------------------------------------
# How PartyCo is made, as opposed to what PartyCo is.
#
# This repository publishes the program. The apparatus used to build it stays on the maintainer's
# machine: project documents and research, the design exports the visuals are derived from, and the
# script that extracts icons out of them. None of it is needed to build, run or modify the app —
# tokens and icons are committed in their generated form — and none of it is anyone else's business.
#
# These paths are ignored rather than deleted: they are live working material, and a contributor who
# happens to create a folder by one of these names will simply find git quiet about it.
# ---------------------------------------------------------------------------
docs/
design/
.claude/
packages/icons/scripts/extract.mjs

# local state
*.log
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
